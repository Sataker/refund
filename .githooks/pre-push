#!/bin/sh
# Freeze: no push after 30/11/2026 23:00 BRT (= 2026-12-01T02:00:00Z) until the final.
DEADLINE=$(date -u -d '2026-12-01T02:00:00Z' +%s 2>/dev/null || date -u -j -f '%Y-%m-%dT%H:%M:%SZ' '2026-12-01T02:00:00Z' +%s)
REOPENS=$(date -u -d '2026-12-12T11:00:00Z' +%s 2>/dev/null || date -u -j -f '%Y-%m-%dT%H:%M:%SZ' '2026-12-12T11:00:00Z' +%s)
NOW=$(date -u +%s)
[ -n "$DEADLINE" ] && [ -n "$REOPENS" ] || { echo "pre-push: could not parse the freeze dates"; exit 1; }
if [ "$NOW" -ge "$DEADLINE" ] && [ "$NOW" -lt "$REOPENS" ]; then
  echo "BLOCKED: repository frozen until the final (rules 8.4)."; exit 1
fi
