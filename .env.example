# No variable is needed to run /demo: pnpm install && pnpm dev
# Every variable below is optional. A missing one turns its capability off; the build never breaks.
# Reference: docs/architecture/INFRA-CI.md §1 (kept outside Git).

# --- Live mode (/app) ---
# DATA_MODE=live                      # live | replay (default replay)
# LOCAL_DEV_PLAN=business             # next dev only, never on Vercel: unlocks that plan locally to read every calculation
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# DATABASE_URL=                       # Supabase transaction pooler :6543 (turns on the database)
# SESSION_SECRET=                     # openssl rand -base64 32 (anonymous session cookie)
# ENCRYPTION_KEY=                     # openssl rand -base64 32 (AES-256-GCM, 32 bytes)
# PII_PEPPER=                         # openssl rand -base64 32 (HMAC of CPF, e-mail, IP)

# --- AI (Claude via Vercel AI Gateway; on Vercel, OIDC is automatic) ---
# AI_GATEWAY_API_KEY=

# --- Open Finance (Pluggy sandbox) ---
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# PLUGGY_WEBHOOK_SECRET=              # openssl rand -hex 32

# --- E-mail (Resend) ---
# RESEND_API_KEY=
# RESEND_FROM=Refund <onboarding@resend.dev>
# RESEND_WEBHOOK_SECRET=

# --- Payments (AbacatePay Pix) ---
# ABACATEPAY_API_KEY=                 # Test Mode key locally
# ABACATEPAY_WEBHOOK_SECRET=          # openssl rand -hex 32 (the same value typed when creating the webhook)
# ABACATEPAY_API_BASE_URL=            # tests only: a local fake; ignored unless the key is a Test Mode key
# VALIDATION_OFFER_CODE=              # >= 12 chars; enables /app/plano?oferta=validacao&codigo=<code> (R$ 1,00 offer)

# --- "Law changed" monitor (Firecrawl) ---
# FIRECRAWL_WEBHOOK_SECRET=

# --- Login (WorkOS AuthKit, P1) ---
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_COOKIE_PASSWORD=             # >= 32 characters
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Operations ---
# ADMIN_EMAILS=
# CRON_SECRET=                        # openssl rand -hex 32
# DB_SSL=disable                      # only for a local Postgres without TLS

# --- Local scripts only (never on Vercel) ---
# DATABASE_URL_DIRECT=                # Supabase direct connection :5432 (migrations)
# FIRECRAWL_API_KEY=
# RECORD_AI_GATEWAY_API_KEY=
