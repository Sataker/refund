{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["DATA_MODE", "NEXT_PUBLIC_*"]
    }
  },
  "globalPassThroughEnv": [
    "LIVE",
    "FC_NUM_RUNS",
    "CI",
    "REFUND_CAPTURES_DIR",
    "REFUND_CNAE_CAPTURES"
  ]
}
